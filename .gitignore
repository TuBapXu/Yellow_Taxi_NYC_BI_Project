# ==============================================================================
# GITIGNORE CHO DỰ ÁN KHO DỮ LIỆU NYC YELLOW TAXI (NHÓM 09)
# Đảm bảo an toàn bảo mật, loại bỏ dữ liệu thô lớn và file tạm sinh tự động
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BẢO MẬT & THÔNG TIN KẾT NỐI (SECRETS & LOCAL ENV)
# ------------------------------------------------------------------------------
# Tuyệt đối không commit file chứa mật khẩu thật
.env
.env.*
!.env.example

# SSH tunnels và khóa mã hóa
**/.ssh_tunnel/
*.pem
*.key
*.p12
*.pfx

# ------------------------------------------------------------------------------
# 2. RUNTIME CỦA MAGE.AI & NHẬT KÝ THỰC THI (MAGE RUNTIME & LOGS)
# ------------------------------------------------------------------------------
# Thư mục lưu trạng thái và cache của Mage
mage_data/
**/.cache/
*.log
**/logs/

# ------------------------------------------------------------------------------
# 3. PYTHON COMPILATION & MÔI TRƯỜNG ẢO
# ------------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 4. DBT ARTIFACTS (BUILD OUTPUTS)
# ------------------------------------------------------------------------------
# dbt target và packages tự sinh khi dbt run/compile
**/target/
**/dbt_packages/
**/dbt_modules/

# ------------------------------------------------------------------------------
# 5. DỮ LIỆU LỚN & DATABASE NỘI BỘ (RAW BIG DATA & LOCAL DB)
# ------------------------------------------------------------------------------
# Loại bỏ các tệp dữ liệu thô lớn (Parquet, Shapefile, ZIP, v.v.)
*.parquet
*.zip
*.tar.gz
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Thư mục data lớn (giữ lại fixture nhỏ trong data/mock/ để kiểm thử)
Data/*
data/*
!data/mock/
!data/mock/**

# Local database volumes & dumps
pgdata/
*.db
*.db-shm
*.db-wal
*.dump
*.backup
*.sql.gz

# ------------------------------------------------------------------------------
# 6. IDE, EDITOR & OS ARTIFACTS
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Hệ điều hành (Windows / macOS)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Tệp khóa tạm thời của Microsoft Office (Word, Excel)
~$*
*.tmp

# Không push tài liệu nội bộ
docs/*
# Ngoai le: contract staging B01 dung chung cho ca nhom
!docs/data_contract_v1.md
**/.user.yml

docs/TASK_T01*

# File xuat ra tu Claude (zip, pdf gui nhom) - khong dua len Git
Claude outputs/
